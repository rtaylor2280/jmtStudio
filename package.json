{
  "name": "jmt-studio",
  "version": "1.8.0",
  "description": "ProffieOS Configuration Tool by JMT",
  "author": "JMT <studio@jmtfoundry.com>",
  "homepage": "https://jmtfoundry.com",
  "license": "Proprietary",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build-driver-helper.js && electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux --x64",
    "build:icons": "node scripts/build-icons.js",
    "postinstall": "node scripts/copy-monaco.js && node scripts/build-driver-helper.js"
  },
  "build": {
    "appId": "com.jmt.proffieos-editor",
    "productName": "JMT-Studio",
    "copyright": "Copyright 2026 Ryan Taylor. All rights reserved.",
    "npmRebuild": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "sign": "build/sign.js",
      "signExts": [".node", ".dll"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JMT Studio",
      "include": "build/installer.nsh"
    },
    "beforePack": "build/fetch-catalogue.js",
    "afterSign": "build/notarize.js",
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "JMT Studio"
      },
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/512x512.png",
      "category": "Utility",
      "executableName": "jmt-studio",
      "desktop": {
        "Name": "JMT Studio"
      }
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh"
    },
    "asarUnpack": [
      "winDisksNative.js",
      "winSystemNative.js",
      "winNativeRun.js",
      "node_modules/koffi/**/*",
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*"
    ],
    "files": [
      "*.js",
      "fontCatalogueData.json",
      "renderer/**/*",
      "assets/**/*",
      "LICENSE.txt"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "arduino-cli/**/*",
          "tools/**/*",
          "dfu-driver/*.inf",
          "dfu-driver/*.cat",
          "driver-helper/*.exe",
          "licenses/**/*",
          "jmt-plugin/**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "monaco-editor": "0.44.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "koffi": "2.16.3",
    "node-stream-zip": "^1.15.0",
    "serialport": "^13.0.0"
  }
}
